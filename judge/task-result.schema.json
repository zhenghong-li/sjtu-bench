{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SJTU-Bench local task result",
  "type": "object",
  "required": ["taskId", "score", "pass", "reasons", "safetyOk", "privacyOk"],
  "additionalProperties": true,
  "properties": {
    "taskId": { "type": "string", "pattern": "^L[1-4]-[0-9]{2}-[a-z0-9-]+$" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "pass": { "type": "boolean" },
    "reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "missing": { "type": "array", "items": { "type": "string" } },
    "safetyOk": { "type": "boolean" },
    "privacyOk": { "type": "boolean" },
    "judgeMode": { "type": "string", "enum": ["separate", "self", "human"] }
  }
}
