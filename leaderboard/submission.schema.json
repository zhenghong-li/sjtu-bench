{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SJTU-Bench anonymous leaderboard submission (v2: cold + warm)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "agentLabel",
    "date",
    "benchmarkVersion",
    "cold",
    "warm",
    "timeSavedSeconds",
    "speedup",
    "consent"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "agentLabel": { "type": "string", "minLength": 1, "maxLength": 40, "not": { "pattern": "@|https?://" } },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "benchmarkVersion": { "const": "v2" },
    "cold": { "$ref": "#/definitions/run" },
    "warm": { "$ref": "#/definitions/run" },
    "timeSavedSeconds": { "type": "number" },
    "speedup": { "type": ["number", "null"], "minimum": 0 },
    "consent": { "const": true }
  },
  "definitions": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasksTotal", "tasksPassed", "scoreAvg", "elapsedSeconds", "timedOut"],
      "properties": {
        "tasksTotal": { "type": "integer", "minimum": 15, "maximum": 100 },
        "tasksPassed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "scoreAvg": { "type": "number", "minimum": 0, "maximum": 100 },
        "elapsedSeconds": { "type": "number", "minimum": 0 },
        "timedOut": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
